# This site's public URL (the OpenAuth callback is WEB_URL/api/auth/callback).
WEB_URL=http://localhost:3000
# The API's public URL. It is also the OpenAuth issuer the browser is sent to for sign-in.
API_URL=http://localhost:4000
# Optional: where the web server reaches the API (Railway's private network). Defaults to API_URL.
# API_INTERNAL_URL=http://api.railway.internal:4000
