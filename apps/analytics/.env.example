# Local development. Copy to .env (pnpm dev loads it).
PORT=4100
# Without DATABASE_URL and S3_BUCKET the lake is two local stand-ins under
# LAKE_LOCAL_DIRECTORY (default ".lake"): a DuckDB-file catalog and a data folder.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/waifu
# S3_BUCKET=
# S3_ENDPOINT=https://t3.storageapi.dev
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# Bearer token for GET /v1/fuwa/summary. Unset means nobody can read.
ANALYTICS_READ_TOKEN=dev-read-token
# How often buffered events are written to the lake (default 30 seconds).
# INGEST_FLUSH_INTERVAL=5 seconds
# The server listens on "::" (Railway's private network is IPv6). Uncomment if your machine has no IPv6.
# HOST=0.0.0.0
