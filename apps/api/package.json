    "@effect/platform-node": "^0.108.2",
    "@effect/sql": "^0.52.1",
    "@effect/sql-drizzle": "^0.51.0",
    "@effect/sql-pg": "^0.53.0",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "@openauthjs/openauth": "^0.4.3",
    "@waifu-devs/domain": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "effect": "^3.22.2",
    "hono": "^4.13.10",
    "pg": "^8.16.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.11",
