# Local development. Copy to .env (pnpm dev loads it).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/waifu
PORT=4000
# This API's public URL (the OpenAuth issuer) and the web app's URL.
ISSUER_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# A GitHub OAuth app whose callback URL is http://localhost:4000/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The server listens on "::" (Railway's private network is IPv6). Uncomment if your machine has no IPv6.
# HOST=0.0.0.0
