{
  "name": "waifu-devs",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @waifu-devs/api db:generate",
    "db:migrate": "pnpm --filter @waifu-devs/api db:migrate"
  },
  "devDependencies": {
    "railway": "^3.11.0"
  },
  "engines": {
    "node": "22.x"
  }
}
